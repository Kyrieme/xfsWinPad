// Generated by CMake from resources/version.rc.in - do not edit.
// VS_VERSION_INFO block; the installer reads FileVersion from the exe at
// install time (installer/Setup.cs) for the Add/Remove-Programs entry.
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "xfsWinPad Project"
            VALUE "FileDescription", "xfsWinPad - Professional Windows Text Editor"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "xfsWinPad"
            VALUE "LegalCopyright", "Copyright (C) xfsWinPad Project"
            VALUE "OriginalFilename", "xfsWinPad.exe"
            VALUE "ProductName", "xfsWinPad"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
