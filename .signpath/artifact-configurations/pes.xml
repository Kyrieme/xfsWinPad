<?xml version="1.0" encoding="utf-8"?>
<!-- Signs the individual PE files shipped inside the payload / portable zip. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="xfsWinPad.exe" />
      <include path="xfsWinPadPluginHost.exe" />
      <include path="xtaclean.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
